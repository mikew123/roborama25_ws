<?xml version="1.0" ?>
<robot name="roborama25" xmlns:xacro="http://ros.org/wiki/xacro">

<!-- Roborama robot model, all joints fixed (even wheels), no camera, link names match udemy_ws turtlebot3 6can -->
  <!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link" />
    <origin xyz="0 0 0.042" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.005" radius="0.180"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- <joint name="wheel_left_joint" type="continuous"> -->
  <joint name="wheel_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.140 0" rpy="-1.57 0 0"/>
    <!-- <axis xyz="0 0 1"/> -->
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.020" radius="0.042"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <!-- <joint name="wheel_right_joint" type="continuous"> -->
  <joint name="wheel_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.140 0" rpy="-1.57 0 0"/>
    <!-- <axis xyz="0 0 1"/> -->
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.020" radius="0.042"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.125 0 -0.035" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.050" radius="0.020"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.020" radius="0.025"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="scan_jointl" type="fixed">
    <parent link="base_link"/>
    <child link="base_scanl"/>
    <origin xyz="0.140 0.060 0.030" rpy="0 0 -0.08"/>
  </joint>

  <link name="base_scanl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -0.08"/>
      <geometry>
        <cylinder length="0.030" radius="0.020"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="scan_jointr" type="fixed">
    <parent link="base_link"/>
    <child link="base_scanr"/>
    <origin xyz="0.140 -0.060 0.030" rpy="0 0 0.08"/>
  </joint>

  <link name="base_scanr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.030" radius="0.020"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="range_jointf" type="fixed">
    <parent link="base_link"/>
    <child link="base_rangef"/>
    <origin xyz="0.100 0 0.030" rpy="0 0 0"/>
  </joint>

  <link name="base_rangef">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.025 0.025"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="range_jointrc" type="fixed">
    <parent link="base_link"/>
    <child link="base_rangerc"/>
    <origin xyz="-0.040 0 0.085" rpy="0 0 3.1416"/>
  </joint>

  <link name="base_rangerc">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.005" radius="0.015"/>
        </geometry>
      <material name="red"/>
    </visual>
  </link>


  <joint name="range_jointrl" type="fixed">
    <parent link="base_link"/>
    <child link="base_rangerl"/>
    <origin xyz="-0.040 0 0.085" rpy="0 0 2.3"/>
  </joint>

  <link name="base_rangerl">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.005" radius="0.015"/>
        </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="range_jointrr" type="fixed">
    <parent link="base_link"/>
    <child link="base_rangerr"/>
    <origin xyz="-0.040 0 0.085" rpy="0 0 -2.3"/>
  </joint>

  <link name="base_rangerr">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.005" radius="0.015"/>
        </geometry>
      <material name="red"/>
    </visual>
  </link>

</robot>
